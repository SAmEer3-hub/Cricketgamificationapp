<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B22"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvDetailLeagueName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="League"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
                <TextView
                    android:id="@+id/tvDetailMatchName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Match"
                    android:textSize="12sp"
                    android:textColor="#8B949E"/>
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ── MAIN CONTENT: split into top (leaderboard) and bottom (chat) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- ── TOP HALF: Leaderboard + Actions ── -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- League code + share strip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#161B22"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Invite Code: "
                        android:textSize="13sp"
                        android:textColor="#8B949E"/>

                    <TextView
                        android:id="@+id/tvDetailCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FCK284"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#F0883E"
                        android:letterSpacing="0.1"
                        android:layout_marginEnd="12dp"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:id="@+id/tvShareCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📤 Share"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#58A6FF"/>

                </LinearLayout>

                <!-- ── Status banner ── -->
                <TextView
                    android:id="@+id/tvDetailStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⏳ Waiting for opponent to join..."
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:background="#238636"
                    android:gravity="center"
                    android:padding="10dp"/>

                <!-- ── LEADERBOARD ── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Leaderboard"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLeaderboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>

                <!-- ── ACTIONS ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp">

                    <!-- Select team button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectTeam"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🏏 Select My Team"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#1F6FEB"
                        app:cornerRadius="10dp"
                        android:layout_marginBottom="8dp"
                        android:visibility="visible"/>

                    <!-- Calculate scores button (shown when both have teams) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCalculateScores"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="⚡ Calculate Final Scores"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#9E6A03"
                        app:cornerRadius="10dp"
                        android:visibility="gone"/>

                    <!-- Progress + messages -->
                    <ProgressBar
                        android:id="@+id/progressDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/tvDetailMsg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="#3FB950"
                        android:gravity="center"
                        android:visibility="gone"
                        android:paddingTop="4dp"/>

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ── DIVIDER ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#21262D"/>

        <!-- ── BOTTOM HALF: CHAT ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#0D1117">

            <!-- Chat header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💬 League Chat"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvLiveDot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● LIVE"
                    android:textSize="10sp"
                    android:textColor="#3FB950"/>

            </LinearLayout>

            <!-- Messages list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChat"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingVertical="4dp"
                android:clipToPadding="false"/>

            <!-- Message input row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#161B22"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etChatInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Type a message..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8B949E"
                    android:textSize="14sp"
                    android:background="@drawable/bg_tab_unselected"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:inputType="textCapSentences"
                    android:maxLines="3"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendMessage"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="➤"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#1F6FEB"
                    app:cornerRadius="24dp"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>