<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="#161B22"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── TOP ROW: Match Name + Status Badge ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <!-- Match Name -->
            <TextView
                android:id="@+id/tvContestMatchName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="India vs Australia"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tvContestStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WAITING"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_status_upcoming"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"/>

        </LinearLayout>

        <!-- ── PLAYER MATCHUP ROW ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <!-- Player 1 Block -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical"
                android:gravity="center">

                <!-- Avatar circle -->
                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:id="@+id/tvUser1Avatar"
                    android:gravity="center"
                    android:text="P"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_avatar_blue"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvUser1Name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="You"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tvUser1Score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="- pts"
                    android:textSize="12sp"
                    android:textColor="#8B949E"
                    android:layout_gravity="center"/>

            </LinearLayout>

            <!-- VS divider -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VS"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#58A6FF"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 v 1"
                    android:textSize="10sp"
                    android:textColor="#8B949E"/>

            </LinearLayout>

            <!-- Player 2 Block -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical"
                android:gravity="center">

                <!-- Avatar circle -->
                <TextView
                    android:id="@+id/tvUser2Avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="?"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_avatar_gray"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvUser2Name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Waiting..."
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#8B949E"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tvUser2Score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="- pts"
                    android:textSize="12sp"
                    android:textColor="#8B949E"
                    android:layout_gravity="center"/>

            </LinearLayout>

        </LinearLayout>

        <!-- ── DIVIDER ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#21262D"
            android:layout_marginBottom="12dp"/>

        <!-- ── BOTTOM ROW: Contest ID + Action Button ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Contest ID (short) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contest ID"
                    android:textSize="10sp"
                    android:textColor="#8B949E"/>

                <TextView
                    android:id="@+id/tvContestId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#XXXXX"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#58A6FF"/>

            </LinearLayout>

            <!-- View Result Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewContest"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="View Details"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1F6FEB"
                app:cornerRadius="8dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>