<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B22"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆 Private Leagues"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>
        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- ── CREATE LEAGUE CARD ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#161B22"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="➕ Create a Private League"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="14dp"/>

                    <!-- League name input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilLeagueName"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:boxStrokeColor="#30363D"
                        app:boxBackgroundColor="#0D1117"
                        app:hintTextColor="#8B949E">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLeagueName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="League name (e.g. Virat vs Babar)"
                            android:inputType="textCapWords"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#8B949E"
                            android:paddingHorizontal="12dp"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Match selector label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selected match:"
                        android:textSize="12sp"
                        android:textColor="#8B949E"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvCreateSelectedMatch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No match selected — go back and tap 'Play Now' first"
                        android:textSize="13sp"
                        android:textColor="#C9D1D9"
                        android:background="@drawable/bg_tab_unselected"
                        android:padding="12dp"
                        android:gravity="center"
                        android:layout_marginBottom="16dp"/>

                    <!-- Success/Error messages -->
                    <TextView
                        android:id="@+id/tvCreateSuccess"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="#3FB950"
                        android:gravity="center"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvCreateError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="#F85149"
                        android:gravity="center"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp"/>

                    <ProgressBar
                        android:id="@+id/progressCreate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCreateLeague"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Create League &amp; Get Invite Code"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#238636"
                        app:cornerRadius="10dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── JOIN LEAGUE CARD ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#161B22"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔗 Join with Invite Code"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="14dp"/>

                    <!-- Code input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilJoinCode"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:boxStrokeColor="#30363D"
                        app:boxBackgroundColor="#0D1117"
                        app:hintTextColor="#8B949E">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etJoinCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter code e.g. FCK284"
                            android:inputType="textCapCharacters"
                            android:maxLength="6"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#8B949E"
                            android:textSize="20sp"
                            android:letterSpacing="0.2"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvJoinSuccess"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="#3FB950"
                        android:gravity="center"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvJoinError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="#F85149"
                        android:gravity="center"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp"/>

                    <ProgressBar
                        android:id="@+id/progressJoin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnJoinLeague"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Join League"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#1F6FEB"
                        app:cornerRadius="10dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── MY LEAGUES SECTION ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="My Leagues"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/tvRefreshLeagues"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔄 Refresh"
                    android:textSize="13sp"
                    android:textColor="#58A6FF"/>

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressLeaguesList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvNoLeagues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No leagues yet.\nCreate one above or ask a friend for a code!"
                android:textSize="14sp"
                android:textColor="#8B949E"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLeagues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>