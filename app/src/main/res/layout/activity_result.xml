<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <!-- ── APP BAR ── -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B22"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvResultTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contest Result"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/tvResultMatchName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="India vs Australia"
                    android:textSize="12sp"
                    android:textColor="#8B949E"/>

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ── SCROLLABLE CONTENT ── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- ── LOADING STATE ── -->
            <LinearLayout
                android:id="@+id/layoutLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="48dp"
                android:visibility="visible">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tvLoadingMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculating scores..."
                    android:textSize="14sp"
                    android:textColor="#8B949E"/>

            </LinearLayout>

            <!-- ── ERROR STATE ── -->
            <TextView
                android:id="@+id/tvResultError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="14sp"
                android:textColor="#F85149"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone"/>

            <!-- ── RESULT CONTENT (hidden during loading) ── -->
            <LinearLayout
                android:id="@+id/layoutResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- ── WINNER ANNOUNCEMENT CARD ── -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="#161B22"
                    app:cardElevation="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp">

                        <!-- Trophy / Handshake emoji -->
                        <TextView
                            android:id="@+id/tvTrophy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏆"
                            android:textSize="52sp"
                            android:layout_marginBottom="8dp"/>

                        <!-- Winner label -->
                        <TextView
                            android:id="@+id/tvWinnerLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WINNER"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#F0883E"
                            android:letterSpacing="0.15"
                            android:layout_marginBottom="4dp"/>

                        <!-- Winner name (large) -->
                        <TextView
                            android:id="@+id/tvWinnerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Virat"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:layout_marginBottom="4dp"/>

                        <!-- Winner score -->
                        <TextView
                            android:id="@+id/tvWinnerScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="687 pts"
                            android:textSize="18sp"
                            android:textColor="#3FB950"
                            android:textStyle="bold"
                            android:layout_marginBottom="20dp"/>

                        <!-- ── SCORE COMPARISON ── -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- User 1 -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/tvUser1Avatar"
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    android:gravity="center"
                                    android:text="A"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"
                                    android:background="@drawable/bg_avatar_blue"
                                    android:layout_marginBottom="8dp"/>

                                <TextView
                                    android:id="@+id/tvResultUser1Name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Player 1"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:layout_marginBottom="4dp"/>

                                <!-- Score pill -->
                                <TextView
                                    android:id="@+id/tvResultUser1Score"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 pts"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"
                                    android:background="@drawable/bg_score_pill_blue"
                                    android:paddingHorizontal="14dp"
                                    android:paddingVertical="6dp"
                                    android:layout_gravity="center"/>

                            </LinearLayout>

                            <!-- VS -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="VS"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="#58A6FF"/>

                            </LinearLayout>

                            <!-- User 2 -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/tvUser2Avatar"
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    android:gravity="center"
                                    android:text="B"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"
                                    android:background="@drawable/bg_avatar_green"
                                    android:layout_marginBottom="8dp"/>

                                <TextView
                                    android:id="@+id/tvResultUser2Name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Player 2"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:layout_marginBottom="4dp"/>

                                <TextView
                                    android:id="@+id/tvResultUser2Score"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 pts"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"
                                    android:background="@drawable/bg_score_pill_green"
                                    android:paddingHorizontal="14dp"
                                    android:paddingVertical="6dp"
                                    android:layout_gravity="center"/>

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- ── TAB SWITCHER: My Team / Opponent ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/tabMyTeam"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="My Team"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_tab_selected"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/tabOpponentTeam"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Opponent's Team"
                        android:textSize="14sp"
                        android:textColor="#8B949E"
                        android:background="@drawable/bg_tab_unselected"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:layout_marginStart="6dp"/>

                </LinearLayout>

                <!-- ── TEAM SCORE SUMMARY HEADER ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/tvBreakdownTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Player Breakdown"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>

                    <TextView
                        android:id="@+id/tvTeamTotalScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total: 0 pts"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#3FB950"/>

                </LinearLayout>

                <!-- ── PLAYER SCORE LIST ── -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPlayerScores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>

                <!-- ── DIVIDER ── -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#21262D"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"/>

                <!-- ── SHARE / GO HOME BUTTONS ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoToDashboard"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="🏠 Dashboard"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#1F6FEB"
                        app:cornerRadius="10dp"
                        android:layout_marginEnd="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlayAgain"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="🏏 Play Again"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#238636"
                        app:cornerRadius="10dp"
                        android:layout_marginStart="8dp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>