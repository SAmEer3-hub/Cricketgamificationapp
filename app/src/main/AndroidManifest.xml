<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Fantasy Cricket"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FantasyCricketApp">

        <activity android:name=".ui.auth.LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".ui.auth.SignupActivity"          android:exported="false"/>
        <activity android:name=".ui.dashboard.MainActivity"       android:exported="false"/>
        <activity android:name=".ui.team.TeamSelectionActivity"   android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.contest.ContestActivity"      android:exported="false"/>
        <activity android:name=".ui.result.ResultActivity"        android:exported="false"/>


        <activity android:name=".ui.league.LeagueActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.league.LeagueDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.profile.UserProfileActivity"  android:exported="false"/>



    </application>

</manifest>